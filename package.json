{
  "name": "golden-valley-farm",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node tools/build-static.mjs",
    "cap:sync": "npm run build:static && npx cap sync android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug --no-daemon",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:text": "node tools/lint-text.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check-assets": "node tools/check-assets.mjs",
    "roadmap": "node tools/gen-roadmap.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run typecheck && npm run lint && npm run lint:text && npm run check-assets && npm run test:coverage && npm run build",
    "story-map": "node tools/story-map.mjs",
    "doc-icons": "npx --yes tsx tools/doc-icons.mts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "version": "0.1.0",
  "description": "مزرعه طلایی — بازی مزرعه‌داری ایزومتریک ۲.۵ بعدی، آفلاین‌فِرست و فول‌تاچ برای موبایل",
  "license": "MIT",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
