# === پایگاه‌داده (اختیاری) ===
# اگر خالی بماند، بازی کاملاً آفلاین روی دستگاه ذخیره می‌کند و بیلد هم بدون دیتابیس موفق می‌شود.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# شمارِ پراکسی‌های مطمئنِ جلوی سرور برای خواندنِ IP از X-Forwarded-For (Vercel یا یک nginx = 1؛ CDN + nginx = 2)
# TRUSTED_PROXY_HOPS=1

# === سقفِ نرخِ توزیع‌شده (اختیاری — R/T5) ===
# بدونِ این‌ها سقفِ نرخ در حافظه‌ی هر پروسه است: روی استقرارِ تک‌پروسه سخت، ولی روی
# serverless/چند‌اینستنس نرم (هر instance سطلِ خودش را دارد و cold start آن را صفر می‌کند).
# با یک Redisِ سازگار با RESTِ Upstash، سطل‌ها توزیع‌شده و اتمی می‌شوند.
# RATE_LIMIT_REDIS_REST_URL=https://xxxx.upstash.io
# RATE_LIMIT_REDIS_REST_TOKEN=xxxx
# خطای شبکه به‌طور پیش‌فرض fail-open است (بازی نباید به‌خاطرِ سقفِ نرخ بخوابد)؛
# برای بستنِ سخت: RATE_LIMIT_FAIL_CLOSED=1

# === گزارشِ خطای کلاینت (اختیاری — R/T6) ===
# بدونِ این مقدار، /api/log همان گزارشِ تلاش‌محورِ نرخِ‌محدودشده می‌ماند (فقط فیلدهای
# شناخته‌شده و کوتاه‌شده ثبت می‌شوند و IP خام نمی‌رود). اگر پشتِ یک پروکسیِ مطمئن هستی
# که سرآیندِ x-log-secret را اضافه می‌کند، این را تنظیم کن تا مسار برای بیرون بسته شود.
# LOG_SHARED_SECRET=یک-رشته‌ی-تصادفی-بلند

# === تستِ محلیِ لایه‌ی پایگاه‌داده (اختیاری — R/T7) ===
# با این متغیر، tests/save-pg.test.ts روی Postgresِ واقعیِ شما اجرا می‌شود؛
# بدونِ آن، همان تست با PGlite (Postgresِ درون‌پروسه) اجرا و هیچ‌چیز skip نمی‌شود.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/farm_test
